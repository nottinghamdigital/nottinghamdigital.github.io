---
import { categoryById, type CategoryId } from '../data/categories';

type EventLocation = import('../lib/ics.mjs').EventLocation;

interface EventItem {
	meetupName: string;
	category: CategoryId;
	title: string;
	url: string;
	date: string;
	/** ISO 8601, UTC. Absent when the source gave no end time. */
	end?: string;
	/** Absent when the source gave no venue. */
	location?: EventLocation;
}

interface Props {
	/**
	 * Every known upcoming event, soonest first — not just the soonest day's.
	 * The hero shows the first and keeps the rest in the DOM so it can promote
	 * one itself as events pass, however long the gap to the next one is.
	 */
	events: EventItem[];
}

const { events } = Astro.props;

/**
 * Calendar day in Europe/London, as YYYY-MM-DD — the grouping key behind
 * "+N more", which offers only the events sharing the shown event's date.
 * London rather than the build machine's zone (UTC in CI), so an 8pm event
 * groups with the day it reads as on the card.
 */
const londonDay = (date: string) =>
	new Date(date).toLocaleDateString('en-CA', { timeZone: 'Europe/London' });

const enriched = events.map((e) => {
	const { label: categoryLabel, icon } = categoryById(e.category);
	const formattedDate = new Date(e.date).toLocaleDateString('en-GB', {
		weekday: 'short',
		day: 'numeric',
		month: 'short',
		hour: 'numeric',
		minute: '2-digit',
		timeZone: 'Europe/London',
	});
	return { ...e, categoryLabel, icon, formattedDate, day: londonDay(e.date) };
});

const [first, ...rest] = enriched;
// Only same-day siblings are offered up front; later days are rendered too,
// but stay hidden until one of them is promoted into the card above.
const moreCount = rest.filter((e) => e.day === first.day).length;
---

<div class="next-up">
	<span class="next-up__label">Next up</span>
	<div
		class="next-up__card h-event"
		data-event-date={first.date}
		data-day={first.day}
		data-primary
		style={`--category-color: var(--color-category-${first.category});`}
	>
		<a class="next-up__link u-url" href={first.url} rel="noopener">
			<span class="next-up__stripe">
				<span
					class="icon next-up__icon"
					style={`--icon-src: url(${first.icon});`}
					aria-hidden="true"
				></span>
			</span>
			<span class="next-up__body">
				<time class="next-up__date dt-start" datetime={first.date}>
					{first.formattedDate}
				</time>
				<span class="next-up__title p-name">{first.title}</span>
				<span class="next-up__meetup">{first.meetupName}</span>
			</span>
			<span class="visually-hidden">Category: {first.categoryLabel}</span>
		</a>
		{first.end && <time class="dt-end" datetime={first.end} hidden />}
		{
			first.location?.name && (
				<span class="p-location" hidden>{first.location.name}</span>
			)
		}
		{
			rest.length > 0 && (
				<button
					type="button"
					class="next-up__more"
					aria-expanded="false"
					aria-controls="next-up-more-list"
					aria-label={`Show ${moreCount} more event${moreCount === 1 ? '' : 's'} on this date`}
					data-next-up-toggle
					hidden={moreCount === 0}
				>
					+{moreCount} more
				</button>
			)
		}
	</div>
	{
		rest.length > 0 && (
			<ul class="next-up__more-list" id="next-up-more-list" hidden>
				{rest.map((e) => (
					<li class="next-up__more-item" hidden={e.day !== first.day}>
						<div
							class="next-up__card h-event"
							data-event-date={e.date}
							data-day={e.day}
							data-category={e.category}
							data-icon={e.icon}
							data-formatted-date={e.formattedDate}
							data-title={e.title}
							data-meetup-name={e.meetupName}
							data-category-label={e.categoryLabel}
							data-url={e.url}
							data-end={e.end ?? ''}
							data-location-name={e.location?.name ?? ''}
							style={`--category-color: var(--color-category-${e.category});`}
						>
							<a class="next-up__link u-url" href={e.url} rel="noopener">
								<span class="next-up__stripe">
									<span
										class="icon next-up__icon"
										style={`--icon-src: url(${e.icon});`}
										aria-hidden="true"
									/>
								</span>
								<span class="next-up__body">
									<time class="next-up__date dt-start" datetime={e.date}>
										{e.formattedDate}
									</time>
									<span class="next-up__title p-name">{e.title}</span>
									<span class="next-up__meetup">{e.meetupName}</span>
								</span>
								<span class="visually-hidden">Category: {e.categoryLabel}</span>
							</a>
							{e.end && <time class="dt-end" datetime={e.end} hidden />}
							{
								e.location?.name && (
									<span class="p-location" hidden>{e.location.name}</span>
								)
							}
						</div>
					</li>
				))}
			</ul>
		)
	}
</div>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const root = document.querySelector('.next-up');
		const primary = document.querySelector('.next-up__card[data-primary]');
		const toggle = document.querySelector('[data-next-up-toggle]');
		const list = document.getElementById('next-up-more-list');

		/**
		 * The queued events, soonest first — every upcoming event bar the one in
		 * the card above, whatever day it falls on. Only those sharing the shown
		 * event's day are ever revealed, but the later ones stay here so the hero
		 * has something to promote between the daily rebuilds.
		 */
		function items() {
			if (!(list instanceof HTMLElement)) return [];
			return Array.from(list.querySelectorAll('.next-up__more-item'))
				.map((item) => ({ item, card: item.querySelector('.next-up__card') }))
				.filter(({ item, card }) => item instanceof HTMLElement && card instanceof HTMLElement);
		}

		function hasPassed(card) {
			const eventDate = new Date(card.dataset.eventDate).getTime();
			return !Number.isNaN(eventDate) && eventDate <= Date.now();
		}

		/**
		 * Creates, updates, or removes a hidden h-event value (dt-end,
		 * p-location) that has no visible counterpart to fall back on. Returns
		 * the element actually holding the value (or `insertAfter` if there
		 * is none now), so a second call can chain off it and keep a stable
		 * element order rather than every optional element piling up right
		 * after the link.
		 */
		function syncHiddenValue(card, insertAfter, tagName, className, value) {
			let el = card.querySelector(`${tagName}.${className}`);
			if (!value) {
				el?.remove();
				return insertAfter;
			}
			if (!el) {
				el = document.createElement(tagName);
				el.className = className;
				el.hidden = true;
				insertAfter.after(el);
			}
			if (tagName === 'time') el.setAttribute('datetime', value);
			else el.textContent = value;
			return el;
		}

		function promote(primaryCard, sourceCard) {
			primaryCard.dataset.eventDate = sourceCard.dataset.eventDate;
			primaryCard.dataset.day = sourceCard.dataset.day ?? '';
			primaryCard.style.setProperty(
				'--category-color',
				`var(--color-category-${sourceCard.dataset.category})`,
			);
			const link = primaryCard.querySelector('.next-up__link');
			if (!(link instanceof HTMLElement)) return;
			link.setAttribute('href', sourceCard.dataset.url ?? '');
			const icon = link.querySelector('.next-up__icon');
			if (icon instanceof HTMLElement) {
				icon.style.setProperty('--icon-src', `url(${sourceCard.dataset.icon})`);
			}
			const dateEl = link.querySelector('.next-up__date');
			if (dateEl) {
				dateEl.textContent = sourceCard.dataset.formattedDate ?? '';
				// The visible text is only half of what this element carries —
				// dt-start is read by microformat consumers from `datetime`,
				// which nothing above touches, and a promoted card that fixed
				// only the label would describe the event that just ended.
				dateEl.setAttribute('datetime', sourceCard.dataset.eventDate ?? '');
			}
			const titleEl = link.querySelector('.next-up__title');
			if (titleEl) titleEl.textContent = sourceCard.dataset.title ?? '';
			const meetupEl = link.querySelector('.next-up__meetup');
			if (meetupEl) meetupEl.textContent = sourceCard.dataset.meetupName ?? '';
			const categoryEl = link.querySelector('.visually-hidden');
			if (categoryEl) categoryEl.textContent = `Category: ${sourceCard.dataset.categoryLabel ?? ''}`;

			// dt-end and p-location have no visible element to piggyback a fix
			// onto at all, so they're easy to miss entirely — nothing on
			// screen would look wrong if a promoted card kept the old values.
			let afterEl = syncHiddenValue(primaryCard, link, 'time', 'dt-end', sourceCard.dataset.end);
			syncHiddenValue(primaryCard, afterEl, 'span', 'p-location', sourceCard.dataset.locationName);
		}

		/** Same-day siblings of the event currently shown, i.e. what "+N more" opens. */
		function sameDayItems() {
			if (!(primary instanceof HTMLElement)) return [];
			return items().filter(({ card }) => card.dataset.day === primary.dataset.day);
		}

		function labelToggle(expanded) {
			if (!(toggle instanceof HTMLButtonElement)) return;
			const count = sameDayItems().length;
			toggle.hidden = count === 0;
			toggle.textContent = expanded ? 'Hide other events' : `+${count} more`;
			toggle.setAttribute(
				'aria-label',
				expanded
					? 'Hide other events on this date'
					: `Show ${count} more event${count === 1 ? '' : 's'} on this date`,
			);
		}

		function refresh() {
			if (!(root instanceof HTMLElement) || !(primary instanceof HTMLElement)) return;

			for (const { item, card } of items()) {
				if (hasPassed(card)) item.remove();
			}

			// Nothing passed is left in the queue, so the first entry is the soonest
			// event still to come — whether that is later today or weeks out.
			if (hasPassed(primary)) {
				const next = items()[0];
				if (!next) {
					root.hidden = true;
					return;
				}
				promote(primary, next.card);
				next.item.remove();
			}
			root.hidden = false;

			for (const { item, card } of items()) {
				item.hidden = card.dataset.day !== primary.dataset.day;
			}

			const expanded =
				toggle instanceof HTMLButtonElement &&
				toggle.getAttribute('aria-expanded') === 'true' &&
				sameDayItems().length > 0;
			if (toggle instanceof HTMLButtonElement) {
				toggle.setAttribute('aria-expanded', String(expanded));
			}
			if (list instanceof HTMLElement) list.hidden = !expanded;
			labelToggle(expanded);
		}

		if (toggle instanceof HTMLButtonElement && list instanceof HTMLElement) {
			toggle.addEventListener('click', () => {
				const expanded = toggle.getAttribute('aria-expanded') === 'true';
				toggle.setAttribute('aria-expanded', String(!expanded));
				list.hidden = expanded;
				labelToggle(!expanded);
			});
		}

		refresh();
		setInterval(refresh, 60000);
		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'visible') refresh();
		});
	});
</script>
