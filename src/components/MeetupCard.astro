---
import { CATEGORIES, categoryById, type CategoryId } from '../data/categories';

interface NextEvent {
	title: string;
	url: string;
	date: string;
}

interface Props {
	/** Content collection entry id (the meetup's YAML filename stem) — used only to build unique DOM ids for the edit panel's form fields. */
	id: string;
	name: string;
	url: string;
	summary: string;
	cadence: string;
	category: CategoryId;
	links: { label: string; url: string }[];
	/** The group's next scheduled event, fetched from meetup.com's RSS feed at build time. Absent if there's none scheduled, or the feed couldn't be fetched. */
	nextEvent?: NextEvent;
}

const { id, name, url, summary, cadence, category, links, nextEvent } =
	Astro.props;
const { label: categoryLabel, icon } = categoryById(category);
const nextEventDate = nextEvent
	? new Date(nextEvent.date).toLocaleDateString('en-GB', {
			weekday: 'short',
			day: 'numeric',
			month: 'short',
		})
	: null;

const linksAsText = links.map((l) => `${l.label}: ${l.url}`).join('\n');
---

<li
	class="meetup-card h-card"
	data-category={category}
	data-next-event-date={nextEvent?.date}
	style={`--category-color: var(--color-category-${category});`}
>
	<div class="meetup-card__stripe">
		<span class="icon" style={`--icon-src: url(${icon});`} aria-hidden="true"
		></span>
	</div>

	<button
		type="button"
		class="meetup-card__edit"
		data-edit-toggle
		aria-expanded="false"
		aria-controls={`edit-panel-${id}`}
		aria-label={`Suggest an edit to ${name}`}
	>
		<span class="icon" style="--icon-src: url(/img/edit.svg);" aria-hidden="true"
		></span>
	</button>

	<h2 class="meetup-card__title">
		<a class="meetup-card__link p-name u-url" href={url}>{name}</a>
	</h2>

	<p class="meetup-card__summary p-summary">{summary}</p>

	<p class="meetup-card__meta">
		<span class="meetup-card__cadence">
			<span class="icon" style="--icon-src: url(/img/event.svg);" aria-hidden="true"
			></span>
			<span class="visually-hidden">Meets:</span>
			{cadence}
		</span>

		<span class="visually-hidden">Category: {categoryLabel}</span>
	</p>

	{
		nextEvent && (
			<p class="meetup-card__next-event">
				Next:{' '}
				<a href={nextEvent.url} rel="noopener">
					{nextEventDate}
					<span class="visually-hidden"> — {nextEvent.title}</span>
				</a>
			</p>
		)
	}

	{
		links.length > 0 && (
			<p class="meetup-card__links">
				{links.map((link) => (
					<a href={link.url} rel="me noopener">
						{link.label}
						<span class="visually-hidden"> for {name}</span>
					</a>
				))}
			</p>
		)
	}

	<div
		class="meetup-card__edit-panel"
		id={`edit-panel-${id}`}
		data-edit-panel
		data-group-name={name}
		hidden
	>
		<div class="edit-field">
			<label for={`cadence-${id}`}>Cadence</label>
			<input
				type="text"
				id={`cadence-${id}`}
				data-field="cadence"
				value={cadence}
			/>
		</div>

		<div class="edit-field">
			<label for={`summary-${id}`}>Summary</label>
			<textarea id={`summary-${id}`} data-field="summary" rows="3"
				>{summary}</textarea
			>
		</div>

		<details class="edit-panel__advanced">
			<summary>Advanced — name, URL, category, links</summary>

			<div class="edit-field">
				<label for={`name-${id}`}>Name</label>
				<input type="text" id={`name-${id}`} data-field="name" value={name} />
			</div>

			<div class="edit-field">
				<label for={`url-${id}`}>URL</label>
				<input type="text" id={`url-${id}`} data-field="url" value={url} />
			</div>

			<div class="edit-field">
				<label for={`category-${id}`}>Category</label>
				<select
					id={`category-${id}`}
					data-field="category"
					data-default-value={categoryLabel}
				>
					{
						CATEGORIES.map((c) => (
							<option value={c.label} selected={c.id === category}>
								{c.label}
							</option>
						))
					}
				</select>
			</div>

			<div class="edit-field">
				<label for={`links-${id}`}>Links</label>
				<p class="edit-field__hint">One per line, as Label: https://url</p>
				<textarea
					id={`links-${id}`}
					data-field="links"
					rows={Math.max(2, links.length)}>{linksAsText}</textarea
				>
			</div>
		</details>

		<p class="edit-panel__hint">
			Edit whatever's changed, then continue to GitHub to submit — only
			the fields you've actually changed are carried over.
		</p>

		<a href="#" data-edit-continue class="edit-panel__continue">
			Continue to GitHub
		</a>
	</div>
</li>
