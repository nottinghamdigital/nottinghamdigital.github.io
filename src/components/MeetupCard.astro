---
import { CATEGORIES, categoryById, type CategoryId } from '../data/categories';
import { linkIcon } from '../data/link-icons';

interface NextEvent {
	title: string;
	url: string;
	date: string;
}

interface Props {
	/** Content collection entry id (the meetup's YAML filename stem) — used only to build unique DOM ids for the edit panel's form fields. */
	id: string;
	name: string;
	url: string;
	/** Where the group's events actually live, if different from `url` (e.g. a separate Luma calendar or `/events` page). */
	events?: string;
	summary: string;
	notes?: string;
	cadence: string;
	category: CategoryId;
	links: { label: string; url: string }[];
	/**
	 * The group's upcoming events, soonest first — one per event source
	 * (usually one, but an Eventbrite organizer running multiple series can
	 * contribute several), fetched at build time. Absent if none are
	 * scheduled, or none of the sources could be fetched.
	 */
	nextEvents?: NextEvent[];
}

const {
	id,
	name,
	url,
	events,
	summary,
	notes,
	cadence,
	category,
	links,
	nextEvents,
} = Astro.props;
const { label: categoryLabel, icon } = categoryById(category);
const formatDate = (date: string) =>
	new Date(date).toLocaleDateString('en-GB', {
		weekday: 'short',
		day: 'numeric',
		month: 'short',
		timeZone: 'Europe/London',
	});
const ONE_WEEK_MS = 7 * 24 * 60 * 60 * 1000;
const isThisWeek = (date: string) =>
	new Date(date).getTime() - Date.now() <= ONE_WEEK_MS;

const linksAsText = links.map((l) => `${l.label}: ${l.url}`).join('\n');
---

<li
	class="meetup-card h-card"
	data-category={category}
	data-next-event-date={nextEvents?.[0]?.date}
	style={`--category-color: var(--color-category-${category});`}
>
	<div class="meetup-card__stripe">
		<span class="icon" style={`--icon-src: url(${icon});`} aria-hidden="true"
		></span>
	</div>

	<button
		type="button"
		class="meetup-card__edit"
		data-edit-toggle
		aria-expanded="false"
		aria-controls={`edit-panel-${id}`}
		aria-label={`Suggest an edit to ${name}`}
	>
		<span class="icon" style="--icon-src: url(/img/edit.svg);" aria-hidden="true"
		></span>
	</button>

	<div class="meetup-card__header">
		<h2 class="meetup-card__title">
			<a class="meetup-card__link p-name u-url" href={url}>{name}</a>
		</h2>

		{
			links.length > 0 && (
				<p class="meetup-card__links">
					{links.map((link) => (
						<a href={link.url} rel="me noopener" aria-label={`${link.label} for ${name}`}>
							<span
								class="icon"
								style={`--icon-src: url(${linkIcon(link.label)});`}
								aria-hidden="true"
							/>
						</a>
					))}
				</p>
			)
		}
	</div>

	<p class="meetup-card__summary p-summary">{summary}</p>

	{notes && <p class="meetup-card__notes">{notes}</p>}

	<p class="meetup-card__meta">
		<span class="meetup-card__cadence">
			<span class="icon" style="--icon-src: url(/img/event.svg);" aria-hidden="true"
			></span>
			<span class="visually-hidden">Meets:</span>
			{cadence}
		</span>

		<span class="visually-hidden">Category: {categoryLabel}</span>
	</p>

	{
		nextEvents && nextEvents.length > 0 && (
			<div
				class="meetup-card__next-events"
				data-multiple={nextEvents.length > 1}
			>
				<span class="meetup-card__next-events-label">Next:</span>
				<ul>
					{nextEvents.map((event) => (
						<li>
							<a href={event.url} rel="noopener">
								<span class="meetup-card__next-events-date">
									{formatDate(event.date)}
								</span>
								<span class="meetup-card__next-events-title"> — {event.title}</span>
							</a>
							{isThisWeek(event.date) && (
								<span class="meetup-card__badge">This week</span>
							)}
						</li>
					))}
				</ul>
			</div>
		)
	}

	<div
		class="meetup-card__edit-panel"
		id={`edit-panel-${id}`}
		data-edit-panel
		data-group-name={name}
		hidden
	>
		<div class="edit-field">
			<label for={`cadence-${id}`}>Cadence</label>
			<input
				type="text"
				id={`cadence-${id}`}
				data-field="cadence"
				value={cadence}
			/>
		</div>

		<div class="edit-field">
			<label for={`summary-${id}`}>Summary</label>
			<textarea id={`summary-${id}`} data-field="summary" rows="3"
				>{summary}</textarea
			>
		</div>

		<div class="edit-field">
			<label for={`notes-${id}`}>Notes</label>
			<p class="edit-field__hint">
				A short callout that stands out from the summary, e.g. a venue
				change or booking requirement. Leave blank to keep as-is.
			</p>
			<textarea id={`notes-${id}`} data-field="notes" rows="2"
				>{notes ?? ''}</textarea
			>
		</div>

		<details class="edit-panel__advanced">
			<summary>Advanced — name, URL, events, category, links</summary>

			<div class="edit-field">
				<label for={`name-${id}`}>Name</label>
				<input type="text" id={`name-${id}`} data-field="name" value={name} />
			</div>

			<div class="edit-field">
				<label for={`url-${id}`}>URL</label>
				<input type="text" id={`url-${id}`} data-field="url" value={url} />
			</div>

			<div class="edit-field">
				<label for={`events-${id}`}>Events URL</label>
				<p class="edit-field__hint">
					Only if events live somewhere different from the URL above —
					a separate calendar or /events page.
				</p>
				<input
					type="text"
					id={`events-${id}`}
					data-field="events"
					value={events ?? ''}
				/>
			</div>

			<div class="edit-field">
				<label for={`category-${id}`}>Category</label>
				<select
					id={`category-${id}`}
					data-field="category"
					data-default-value={categoryLabel}
				>
					{
						CATEGORIES.map((c) => (
							<option value={c.label} selected={c.id === category}>
								{c.label}
							</option>
						))
					}
				</select>
			</div>

			<div class="edit-field">
				<label for={`links-${id}`}>Links</label>
				<p class="edit-field__hint">One per line, as Label: https://url</p>
				<textarea
					id={`links-${id}`}
					data-field="links"
					rows={Math.max(2, links.length)}>{linksAsText}</textarea
				>
			</div>
		</details>

		<p class="edit-panel__hint">
			Edit whatever's changed, then continue to GitHub to submit — only
			the fields you've actually changed are carried over.
		</p>

		<a href="#" data-edit-continue class="edit-panel__continue">
			Continue to GitHub
		</a>
	</div>
</li>
