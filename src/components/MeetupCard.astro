---
import { categoryById, type CategoryId } from '../data/categories';
import { linkIcon } from '../data/link-icons';

interface NextEvent {
	title: string;
	url: string;
	date: string;
}

interface Props {
	name: string;
	url: string;
	summary: string;
	cadence: string;
	category: CategoryId;
	links: { label: string; url: string }[];
	/**
	 * The group's upcoming events, soonest first — one per event source
	 * (usually one, but an Eventbrite organizer running multiple series can
	 * contribute several), fetched at build time. Absent if none are
	 * scheduled, or none of the sources could be fetched.
	 */
	nextEvents?: NextEvent[];
}

const { name, url, summary, cadence, category, links, nextEvents } =
	Astro.props;
const { label: categoryLabel, icon } = categoryById(category);
const formatDate = (date: string) =>
	new Date(date).toLocaleDateString('en-GB', {
		weekday: 'short',
		day: 'numeric',
		month: 'short',
		timeZone: 'Europe/London',
	});
const ONE_WEEK_MS = 7 * 24 * 60 * 60 * 1000;
const isThisWeek = (date: string) =>
	new Date(date).getTime() - Date.now() <= ONE_WEEK_MS;
---

<li
	class="meetup-card h-card"
	data-category={category}
	data-next-event-date={nextEvents?.[0]?.date}
	style={`--category-color: var(--color-category-${category});`}
>
	<div class="meetup-card__stripe">
		<span class="icon" style={`--icon-src: url(${icon});`} aria-hidden="true"
		></span>
	</div>

	<div class="meetup-card__header">
		<h2 class="meetup-card__title">
			<a class="meetup-card__link p-name u-url" href={url}>{name}</a>
		</h2>

		{
			links.length > 0 && (
				<p class="meetup-card__links">
					{links.map((link) => (
						<a href={link.url} rel="me noopener" aria-label={`${link.label} for ${name}`}>
							<span
								class="icon"
								style={`--icon-src: url(${linkIcon(link.label)});`}
								aria-hidden="true"
							/>
						</a>
					))}
				</p>
			)
		}
	</div>

	<p class="meetup-card__summary p-summary">{summary}</p>

	<p class="meetup-card__meta">
		<span class="meetup-card__cadence">
			<span class="icon" style="--icon-src: url(/img/event.svg);" aria-hidden="true"
			></span>
			<span class="visually-hidden">Meets:</span>
			{cadence}
		</span>

		<span class="visually-hidden">Category: {categoryLabel}</span>
	</p>

	{
		nextEvents && nextEvents.length > 0 && (
			<div
				class="meetup-card__next-events"
				data-multiple={nextEvents.length > 1}
				data-next-events
			>
				<span class="meetup-card__next-events-label">Next:</span>
				<ul>
					{nextEvents.map((event) => (
						<li data-event-date={event.date}>
							<a href={event.url} rel="noopener">
								<span class="meetup-card__next-events-date">
									{formatDate(event.date)}
								</span>
								<span class="meetup-card__next-events-title"> — {event.title}</span>
							</a>
							{isThisWeek(event.date) && (
								<span class="meetup-card__badge">This week</span>
							)}
						</li>
					))}
				</ul>
			</div>
		)
	}
</li>
