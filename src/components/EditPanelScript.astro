---
/**
 * Drives every meetup card's edit panel (see MeetupCard.astro). Rendered
 * once on the page — not per-card — and uses event delegation so it works
 * for every card regardless of how many there are.
 *
 * Clicking a card's pencil toggles that card's panel open. The panel's
 * name/url/events/cadence/summary/notes/category/links fields are pre-filled with the
 * group's current values (via defaultValue for inputs/textareas, and a
 * data-default-value attribute for the category <select>, since Astro
 * renders them server-side); clicking "Continue to GitHub" compares each
 * field's current value against that original and only carries the ones
 * that actually changed through to the GitHub issue form's query-string
 * prefill — untouched fields are left out, so the GitHub form treats them
 * as "no change" the same way it would for a manually-opened issue.
 *
 * The link's href/target/rel are set on click rather than opened via
 * window.open() — a JS-driven window.open() is an unreliable popup in
 * mobile in-app webviews (including GitHub's own mobile app), which can
 * drop the query string and land on the plain template chooser instead of
 * the prefilled form. Setting a real href and letting the click proceed
 * natively keeps it a normal, trusted link navigation everywhere.
 */
const REPO_ISSUES_URL =
	'https://github.com/nottinghamdigital/nottinghamdigital.github.io/issues/new';
---

<script is:inline define:vars={{ REPO_ISSUES_URL }}>
	document.addEventListener('DOMContentLoaded', () => {
		document.addEventListener('click', (event) => {
			const toggle = event.target.closest('[data-edit-toggle]');
			if (toggle) {
				const panel = toggle
					.closest('.meetup-card')
					?.querySelector('[data-edit-panel]');
				if (!(panel instanceof HTMLElement)) return;
				const expanded = toggle.getAttribute('aria-expanded') === 'true';
				toggle.setAttribute('aria-expanded', String(!expanded));
				panel.hidden = expanded;
				return;
			}

			const continueLink = event.target.closest('[data-edit-continue]');
			if (continueLink) {
				const panel = continueLink.closest('[data-edit-panel]');
				if (!(panel instanceof HTMLElement)) return;

				const groupName = panel.dataset.groupName ?? '';
				const params = new URLSearchParams({
					template: 'suggest-edit.yml',
					title: `[Edit suggestion]: ${groupName}`,
					'group-name': groupName,
				});

				const fieldToParam = {
					name: 'new-name',
					url: 'new-url',
					events: 'new-events',
					cadence: 'new-cadence',
					summary: 'new-summary',
					notes: 'new-notes',
					category: 'new-category',
					links: 'new-links',
				};
				for (const [field, param] of Object.entries(fieldToParam)) {
					const input = panel.querySelector(`[data-field="${field}"]`);
					if (input instanceof HTMLSelectElement) {
						if (input.value !== input.dataset.defaultValue) {
							params.set(param, input.value);
						}
						continue;
					}
					if (
						!(input instanceof HTMLInputElement) &&
						!(input instanceof HTMLTextAreaElement)
					) {
						continue;
					}
					if (input.value.trim() !== input.defaultValue.trim()) {
						params.set(param, input.value.trim());
					}
				}

				continueLink.href = `${REPO_ISSUES_URL}?${params}`;
				continueLink.target = '_blank';
				continueLink.rel = 'noopener';
			}
		});
	});
</script>
