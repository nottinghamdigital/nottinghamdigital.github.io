---
import type { CategoryId } from '../data/categories';

interface Props {
	/** Total meetup count, for the initial screen-reader status message. */
	total: number;
	/** Categories that have at least one meetup in the current dataset. */
	categories: ReadonlyArray<{ id: CategoryId; label: string; icon: string }>;
	/** Whether any meetup in the current dataset has a scheduled next event — controls whether the "Upcoming" toggle renders at all. */
	hasNextEvents: boolean;
}

const { total, categories, hasNextEvents } = Astro.props;
---

<div class="filters" role="group" aria-label="Filter meetups by category">
	<button
		type="button"
		class="filter"
		data-filter="all"
		aria-pressed="true"
		aria-controls="meetup-list"
	>
		All
	</button>
	{
		categories.map((category) => (
			<button
				type="button"
				class="filter"
				data-filter={category.id}
				aria-pressed="false"
				aria-controls="meetup-list"
				style={`--filter-color: var(--color-category-${category.id}); --filter-contrast: var(--color-on-accent);`}
			>
				<span
					class="icon filter__icon"
					style={`--icon-src: url(${category.icon});`}
					aria-hidden="true"
				></span>
				{category.label}
			</button>
		))
	}
	{
		hasNextEvents && (
			<>
				<span class="filters__divider" aria-hidden="true" />
				<button
					type="button"
					class="filter"
					data-toggle="upcoming"
					aria-pressed="false"
					aria-controls="meetup-list"
				>
					<span
						class="icon filter__icon"
						style="--icon-src: url(/img/event.svg);"
						aria-hidden="true"
					/>
					Upcoming
				</button>
			</>
		)
	}
</div>

<p class="visually-hidden" role="status" data-filter-status>
	Showing all {total} meetups.
</p>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const filters = document.querySelectorAll('[data-filter]');
		const upcomingToggle = document.querySelector('[data-toggle="upcoming"]');
		const list = document.getElementById('meetup-list');
		const cards = Array.from(document.querySelectorAll('.meetup-card[data-category]'));
		const originalOrder = cards.slice();
		const status = document.querySelector('[data-filter-status]');
		const orderNote = document.querySelector('[data-order-note]');

		let selectedCategory = 'all';
		let upcomingOnly = false;

		function hidePassedEvents() {
			const now = Date.now();
			for (const card of cards) {
				if (!(card instanceof HTMLElement)) continue;
				const block = card.querySelector('[data-next-events]');
				if (!(block instanceof HTMLElement)) continue;

				let soonest = null;
				for (const item of block.querySelectorAll('li[data-event-date]')) {
					if (!(item instanceof HTMLElement)) continue;
					const eventDate = new Date(item.dataset.eventDate).getTime();
					const passed = !Number.isNaN(eventDate) && eventDate <= now;
					item.hidden = passed;
					if (!passed && (soonest === null || eventDate < soonest)) soonest = eventDate;
				}

				if (soonest === null) {
					block.hidden = true;
					delete card.dataset.nextEventDate;
				} else {
					card.dataset.nextEventDate = new Date(soonest).toISOString();
				}
			}
		}

		function apply() {
			let shown = 0;
			const visible = [];

			for (const card of cards) {
				if (!(card instanceof HTMLElement)) continue;
				const inCategory =
					selectedCategory === 'all' || card.dataset.category === selectedCategory;
				const hasNextEvent = Boolean(card.dataset.nextEventDate);
				const matches = inCategory && (!upcomingOnly || hasNextEvent);
				card.hidden = !matches;
				if (matches) {
					shown++;
					visible.push(card);
				}
			}

			if (list instanceof HTMLElement) {
				const order = upcomingOnly
					? visible.sort(
							(a, b) =>
								new Date(a.dataset.nextEventDate).getTime() -
								new Date(b.dataset.nextEventDate).getTime(),
						)
					: originalOrder;
				for (const card of order) list.appendChild(card);
			}

			for (const filter of filters) {
				if (!(filter instanceof HTMLButtonElement)) continue;
				filter.setAttribute(
					'aria-pressed',
					String(filter.dataset.filter === selectedCategory),
				);
			}
			if (upcomingToggle instanceof HTMLButtonElement) {
				upcomingToggle.setAttribute('aria-pressed', String(upcomingOnly));
			}

			if (status instanceof HTMLElement) {
				const categoryLabel = selectedCategory === 'all' ? '' : ` in ${selectedCategory}`;
				const upcomingLabel = upcomingOnly ? ', soonest first' : '';
				status.textContent = `Showing ${shown} meetup${shown === 1 ? '' : 's'}${categoryLabel}${upcomingLabel}.`;
			}

			if (orderNote instanceof HTMLElement) {
				orderNote.textContent = upcomingOnly
					? 'Meetups ordered by next event, soonest first.'
					: 'Meetups ordered alphabetically.';
			}
		}

		for (const filter of filters) {
			if (!(filter instanceof HTMLButtonElement)) continue;
			filter.addEventListener('click', () => {
				selectedCategory = filter.dataset.filter ?? 'all';
				apply();
			});
		}

		if (upcomingToggle instanceof HTMLButtonElement) {
			upcomingToggle.addEventListener('click', () => {
				upcomingOnly = !upcomingOnly;
				apply();
			});
		}

		hidePassedEvents();
		apply();

		setInterval(() => {
			hidePassedEvents();
			apply();
		}, 60000);
		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState !== 'visible') return;
			hidePassedEvents();
			apply();
		});
	});
</script>
