---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryFilters from '../components/CategoryFilters.astro';
import Logo from '../components/Logo.astro';
import MeetupCard from '../components/MeetupCard.astro';
import NextUpHero from '../components/NextUpHero.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import EditModeToggle from '../components/EditModeToggle.astro';
import EditPanelScript from '../components/EditPanelScript.astro';
import { CATEGORIES } from '../data/categories';
import { GOATCOUNTER_DASHBOARD } from '../data/analytics';
import { loadNextEvents } from '../lib/next-events.mjs';
import { eventGraph, toJsonLdScript } from '../lib/structured-data.mjs';

// Generated by scripts/fetch-next-events.mjs (run via the `prebuild` script),
// keyed by meetup YAML filename stem. loadNextEvents() reads it from disk
// rather than importing it, since the file is gitignored and may not exist
// yet (e.g. `astro dev` without a prior build) — an empty object then, so
// every card just falls back to its static cadence text. Shared with
// src/pages/calendar/[event].ics.ts so both consume the exact same fallback.
const nextEvents = await loadNextEvents();

const meetups = (await getCollection('meetups')).sort((a, b) =>
	a.data.name.localeCompare(b.data.name, 'en-GB'),
);

const usedCategoryIds = new Set(meetups.map((m) => m.data.category));
const activeCategories = CATEGORIES.filter((c) => usedCategoryIds.has(c.id));
const hasNextEvents = meetups.some((m) => nextEvents[m.id]?.length);

/**
 * All known upcoming events across every group, derived from the same
 * generated data as each card's own "Next:" list — no new fetch, and
 * coverage is necessarily partial (only groups whose feed the prebuild
 * script understands appear here). A group can contribute more than one
 * event here (e.g. an Eventbrite organizer running several series).
 */
const allNextEvents = meetups.flatMap((m) =>
	(nextEvents[m.id] ?? []).map((event) => ({
		meetupName: m.data.name,
		category: m.data.category,
		...event,
	})),
);

const sortedNextEvents = allNextEvents.sort(
	(a, b) => new Date(a.date).getTime() - new Date(b.date).getTime(),
);
const heroEvent = sortedNextEvents[0];

/**
 * Every event landing on the hero's calendar day, hero first — the hero
 * component cycles through these on click, so two+ meetups meeting on the
 * same day are all reachable rather than the runners-up just being a count.
 */
const heroDayEvents = heroEvent
	? sortedNextEvents.filter(
			(e) =>
				new Date(e.date).toDateString() === new Date(heroEvent.date).toDateString(),
		)
	: [];

const upcomingEventsCount = allNextEvents.length;

// webcal: rather than https: is what tells a calendar app to subscribe
// (fetch and refresh on its own schedule) instead of just downloading the
// file once. Built from Astro.site rather than hardcoded, so a fork
// publishing under a different domain gets the right link automatically.
const webcalUrl = new URL('/events.ics', Astro.site).toString().replace(
	/^https?:/,
	'webcal:',
);

// One schema.org Event per resolved next event, rendered once as JSON-LD
// rather than itemscope/itemprop microdata on each card — NextUpHero
// rewrites its own DOM when an event passes (see promote() there), so
// attribute-based markup on that card would go stale. null when there are
// no upcoming events at all, in which case nothing is rendered.
const jsonLd = eventGraph(meetups, nextEvents);

const title =
	'Nottingham Digital: Design and Development Events for the Tech Community';
const description =
	'A directory of meetups in Nottingham about design, development, technology, and related topics.';
---

<BaseLayout title={title} description={description}>
	{
		jsonLd && (
			<Fragment slot="head">
				<script type="application/ld+json" set:html={toJsonLdScript(jsonLd)} />
			</Fragment>
		)
	}
	<header class="header">
		<Logo as="h1" />
		<p class="site-strap">Local events for the tech community.</p>
		<p class="site-stats">
			{meetups.length} meetup{meetups.length === 1 ? '' : 's'}
			{upcomingEventsCount > 0 && (
				<>
					{' '}with {upcomingEventsCount} upcoming event
					{upcomingEventsCount === 1 ? '' : 's'}
				</>
			)}
		</p>
		{heroDayEvents.length > 0 && <NextUpHero events={heroDayEvents} />}
		<CategoryFilters
			total={meetups.length}
			categories={activeCategories}
			hasNextEvents={hasNextEvents}
		/>
	</header>

	<main>
		<ol class="meetups" id="meetup-list">
			{
				meetups.map((meetup) => (
					<MeetupCard
						id={meetup.id}
						name={meetup.data.name}
						url={meetup.data.url}
						events={meetup.data.events}
						summary={meetup.data.summary}
						notes={meetup.data.notes}
						cadence={meetup.data.cadence}
						category={meetup.data.category}
						links={meetup.data.links}
						nextEvents={nextEvents[meetup.id]}
					/>
				))
			}
		</ol>
		<p class="note" data-order-note>Meetups ordered alphabetically.</p>
	</main>

	<footer class="footer">
		<p>
			Design by <a href="https://twitter.com/whatjoesays">whatjoesays</a> at{' '}
			<a href="https://wearejh.com/">JH</a>
		</p>
		<p>
			See <a
				href="https://github.com/nottinghamdigital/nottinghamdigital.github.io/graphs/contributors"
				>contributors</a
			> and make <a
				href="https://github.com/nottinghamdigital/nottinghamdigital.github.io/issues"
				>change requests</a
			> on <a href="https://github.com/nottinghamdigital/nottinghamdigital.github.io"
				>GitHub</a
			>
		</p>
		<p>
			Visitor stats are <a href={GOATCOUNTER_DASHBOARD}>public</a> — no cookies,
			no personal data
		</p>
		{
			upcomingEventsCount > 0 && (
				<p>
					<a href={webcalUrl}>Subscribe</a> to every upcoming event in one
					calendar
				</p>
			)
		}
		<EditModeToggle />
		<ThemeToggle />
	</footer>
	<EditPanelScript />
</BaseLayout>
